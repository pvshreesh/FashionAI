# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# AI Provider (gemini = cloud, ollama = local)
AI_PROVIDER=gemini

# Wardrobe image analysis: use local Ollama to avoid Gemini rate limits (20/day free)
# Set to ollama to use local LLM for wardrobe uploads; chat & try-on still use Gemini
WARDROBE_AI_PROVIDER=ollama

# Gemini API (for chat, try-on, and fallback when Ollama unavailable)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (optional; required to persist wardrobe items)
# MongoDB Atlas (free): https://www.mongodb.com/cloud/atlas — then get connection string
# Local: mongodb://localhost:27017/fashion-app
# See docs/DATABASE_SETUP.md for step-by-step setup
DATABASE_URL=

# Image Storage (to be added)
# AWS_S3_BUCKET=your_bucket_name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

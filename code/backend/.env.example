# Environment Variables Template
# Setup: Run "node setup-env.js" or ".\setup-env.ps1" to create .env from this file
# Then edit .env with your real values. .env is gitignored and should never be committed.

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_TRY_ON_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MAX_DIM=1024

# Try-on tuning
TRY_ON_IMAGE_MAX_DIM=512
TRY_ON_JPEG_QUALITY=80

# Text-to-image generation (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Server Configuration
PORT=3000
NODE_ENV=development

# Auth Configuration
# cognito = Amazon Cognito-backed auth using the existing API contract
AUTH_PROVIDER=cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# Database Configuration
# dynamodb = AWS-native persistence for user + wardrobe data
DATABASE_PROVIDER=dynamodb
WARDROBE_MODE=shared
SHARED_WARDROBE_USER_ID=shared
DYNAMODB_USERS_TABLE=fashion-ai-dev-users
DYNAMODB_WARDROBE_TABLE=fashion-ai-dev-wardrobe
# Optional if your deployed table uses legacy key names
# DYNAMODB_WARDROBE_PARTITION_KEY=userID
# DYNAMODB_WARDROBE_SORT_KEY=itemID

# Storage Configuration
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_SIGNED_URL_TTL_SECONDS=3600

# Optional cross-origin configuration for split frontend/backend deployments
# Example: CORS_ORIGINS=https://main.d123example.amplifyapp.com,https://app.example.com
# CORS_ORIGINS=

# Image Storage (future)
# AWS_S3_BUCKET=your_bucket_name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

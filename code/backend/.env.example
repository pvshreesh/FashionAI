# Environment Variables Template
# Setup: Run "node setup-env.js" or ".\setup-env.ps1" to create .env from this file
# Then edit .env with your real values. .env is gitignored - never committed.

# AI: Gemini for all features (chat, analyze, recommendations, rate-item, try-on)
# Get API key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override models (default: gemini-1.5-flash for chat/vision)
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# GEMINI_VISION_MODEL=gemini-1.5-flash
# GEMINI_VISION_MAX_DIM=1024

# Try-on: smaller = faster (512 or 384)
TRY_ON_IMAGE_MAX_DIM=512
TRY_ON_JPEG_QUALITY=80

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (optional; required to persist wardrobe items)
# MongoDB Atlas (free): https://www.mongodb.com/cloud/atlas — then get connection string
# Local: mongodb://localhost:27017/fashion-app
# See docs/DATABASE_SETUP.md for step-by-step setup
DATABASE_URL=

# Image Storage (to be added)
# AWS_S3_BUCKET=your_bucket_name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
